# Copy to `.env` and adjust. All values are optional.
#
# These only bootstrap the FIRST admin account when the database is created.
# After first login the app forces a password change; tokens are configured
# from the web UI and stored in the local SQLite database (never in this file).

# Port the web server listens on (default 8787).
PORT=8787

# First-run admin account (only used when github_issue_solver.db does not exist yet).
GIS_INITIAL_USERNAME=admin
GIS_INITIAL_PASSWORD=change-me-now
